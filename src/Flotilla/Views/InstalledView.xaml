<UserControl x:Class="Flotilla.Views.InstalledView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Flotilla.UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Margin="28,10,28,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Installed" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="32"/>
                <TextBlock Text="{Binding InstalledSummary}" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                           TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource Muted}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Installed.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource Quiet}" Click="OnAllOn" ToolTip="Switch on every installed mod">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPower}" Style="{StaticResource Icon}" Width="13" Height="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Turn all on"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Quiet}" Margin="20,0,0,0" Click="OnAllOff" ToolTip="Switch off every mod. They stay installed.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPower}" Style="{StaticResource Icon}" Width="13" Height="13" Margin="0,0,7,0" Opacity="0.6"/>
                            <TextBlock Text="Turn all off"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="24,0,0,0">
                <Button Margin="0,0,10,0" Click="OnUpdateAll" Content="{Binding UpdateCount}" ContentStringFormat="Update all ({0})">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="OnImport" IsEnabled="{Binding CanImport}"
                        ToolTip="Install the mods in an exported list at the same versions, and switch them on in its order">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon}" Width="14" Height="14" Margin="0,0,9,0"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="OnExport"
                        ToolTip="Save a list of the mods that are switched on, with their versions and load order">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconExport}" Style="{StaticResource Icon}" Width="14" Height="14" Margin="0,0,9,0"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="OnOpenFolder">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}" Width="15" Height="13" Margin="0,0,9,0"/>
                        <TextBlock Text="Open mods folder"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListBox x:Name="Order" Grid.Row="1" Margin="28,0,20,16" ItemsSource="{Binding Installed}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource Row}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 PreviewKeyDown="OnListKey" MouseDoubleClick="OnRowDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="72" Background="Transparent">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open mod page" Click="OnOpenPage"
                                          Visibility="{Binding Tile, Converter={StaticResource VisibleWhenSet}}"/>
                                <MenuItem Header="Open its folder" Click="OnOpenModFolder"
                                          Visibility="{Binding Folder.Path, Converter={StaticResource VisibleWhenSet}}"/>
                                <MenuItem Header="View on the Workshop" Click="OnOpenWorkshop"
                                          Visibility="{Binding WorkshopId, Converter={StaticResource VisibleWhenSet}}"/>
                                <Separator/>
                                <MenuItem Header="Move to top" Click="OnMoveTop"/>
                                <MenuItem Header="Move to bottom" Click="OnMoveBottom"/>
                                <Separator/>
                                <MenuItem Header="{Binding RemoveTip}" Click="OnRemoveNow"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Grip" Background="Transparent" Cursor="SizeAll"
                                ToolTip="Drag to change the load order. Alt with the arrow keys works too."
                                PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                                MouseLeftButtonUp="OnGripUp" LostMouseCapture="OnGripLost">
                            <Path x:Name="GripDots" Data="{StaticResource IconGrip}" Fill="{StaticResource Faint}" Width="7" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="Number" Grid.Column="1" Text="{Binding Ordinal}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Muted}"/>

                        <Grid x:Name="Thumb" Grid.Column="2" Width="96" Height="54" Margin="16,0">
                            <Border CornerRadius="4" Background="{StaticResource Chip}">
                                <Path Data="{StaticResource IconBox}" Style="{StaticResource Icon}" Stroke="{StaticResource Faint}" Width="18" Height="18"/>
                            </Border>
                            <Border CornerRadius="4" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Tile.Blur}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Tile.Thumbnail}" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="Label" Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Text="{Binding Name}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15.5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/>
                        </StackPanel>

                        <Button Grid.Column="4" Height="30" Padding="14,0" FontSize="13" Margin="0,0,14,0"
                                Content="{Binding Tile.Action}" IsEnabled="{Binding Tile.CanInstall}" Tag="{Binding Tile.Progress}"
                                ToolTip="{Binding Tile.UpdateNote}" Click="OnUpdate">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tile.ShowsUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Source}" Value="Missing"/>
                                                <Condition Binding="{Binding Tile.CanInstall}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="ToolTip" Value="Download it again from the Workshop"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border x:Name="Source" Grid.Column="5" VerticalAlignment="Center" Padding="9,2,9,3" CornerRadius="10"
                                Background="{StaticResource Chip}" ToolTip="{Binding SourceTip}">
                            <TextBlock x:Name="SourceText" Text="{Binding SourceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Soft}"/>
                        </Border>

                        <ToggleButton Grid.Column="6" Style="{StaticResource Switch}" Margin="20,0,12,0" IsChecked="{Binding Enabled}" Click="OnToggle"
                                      AutomationProperties.Name="{Binding Name}" ToolTip="Load this mod when UBOAT starts"/>

                        <Button x:Name="Remove" Grid.Column="7" Style="{StaticResource IconButton}" Margin="0,0,14,0" VerticalAlignment="Center"
                                ToolTip="{Binding RemoveTip}" AutomationProperties.Name="{Binding RemoveTip}" Click="OnRemove">
                            <Grid>
                                <Path x:Name="Bin" Data="{StaticResource IconTrash}" Style="{StaticResource Icon}"/>
                                <TextBlock x:Name="Ask" Text="Uninstall?" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </Grid>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Grip" Property="IsMouseOver" Value="True">
                            <Setter TargetName="GripDots" Property="Fill" Value="{StaticResource Soft}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter TargetName="Label" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Number" Property="Foreground" Value="{StaticResource Faint}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source}" Value="Missing">
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Danger}"/>
                            <Setter TargetName="Source" Property="Background" Value="{StaticResource DangerBack}"/>
                            <Setter TargetName="SourceText" Property="Foreground" Value="{StaticResource Danger}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Confirming}" Value="True">
                            <Setter TargetName="Bin" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Ask" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Remove" Property="Padding" Value="12,0"/>
                            <Setter TargetName="Remove" Property="Background" Value="{StaticResource DangerBack}"/>
                            <Setter TargetName="Remove" Property="Foreground" Value="{StaticResource Danger}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Installed.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:Sonar Width="150" Height="150" Margin="0,0,0,24" ShowContacts="False"/>
            <TextBlock Text="Nothing installed yet" HorizontalAlignment="Center" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed"
                       FontWeight="SemiBold" FontSize="22"/>
            <TextBlock Text="Mods you install from Browse show up here, ready to switch on or off." Margin="0,8,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
            <Button Style="{StaticResource Primary}" Content="Browse mods" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OnBrowse"/>
        </StackPanel>

        <StackPanel x:Name="NoMatch" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Visibility="Collapsed">
            <TextBlock x:Name="NoMatchTitle" HorizontalAlignment="Center" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed"
                       FontWeight="SemiBold" FontSize="22"/>
            <TextBlock Text="Try part of the name, or clear the search with Esc." Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </StackPanel>
    </Grid>
</UserControl>
