<UserControl x:Class="Flotilla.Views.ModPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" Height="460" VerticalAlignment="Top" IsHitTestVisible="False" OpacityMask="{StaticResource FadeOut}">
            <Border Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Blur}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Border Background="{StaticResource PageShade}"/>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="28,0,20,48" MaxWidth="1180" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="400" Height="240" VerticalAlignment="Top">
                        <Border CornerRadius="6" Background="{StaticResource Raised}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="44" ShadowDepth="16" Direction="270" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Blur}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="6" Background="#4D000000"/>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Preview}" Stretch="Uniform"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="6" BorderBrush="{StaticResource AccentRing}" BorderThickness="1"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource Quiet}" HorizontalAlignment="Left" Click="OnBack" AutomationProperties.Name="Back to Browse">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBack}" Style="{StaticResource Icon}" Width="7" Height="11" StrokeThickness="1.8"/>
                                <TextBlock Text="Browse" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding Title}" Margin="0,8,0,0" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed" FontWeight="SemiBold"
                                   FontSize="40" LineHeight="44" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Path Data="{StaticResource IconUsers}" Style="{StaticResource Icon}" Stroke="{StaticResource Muted}" Width="14" Height="14"/>
                            <TextBlock Text="{Binding SubscribersLong}" Margin="7,0,22,0" FontSize="13.5" Foreground="{StaticResource Soft}"/>
                            <Path Data="{StaticResource IconClock}" Style="{StaticResource Icon}" Stroke="{StaticResource Muted}" Width="14" Height="14"/>
                            <TextBlock Text="{Binding Updated}" Margin="7,0,22,0" FontSize="13.5" Foreground="{StaticResource Soft}"/>
                            <Path Data="{StaticResource IconBox}" Style="{StaticResource Icon}" Stroke="{StaticResource Muted}" Width="14" Height="14"/>
                            <TextBlock Text="{Binding Size}" Margin="7,0,0,0" FontSize="13.5" Foreground="{StaticResource Soft}"/>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,14,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" Padding="9,2,9,3" CornerRadius="10" Background="{StaticResource TagBack}">
                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TagText}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Primary}" MinWidth="210" Content="{Binding Action}" IsEnabled="{Binding CanInstall}"
                                    Tag="{Binding Progress}" Click="OnInstall"/>
                            <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnOpenInSteam">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExternal}" Style="{StaticResource Icon}" Width="14" Height="14" Margin="0,0,9,0"/>
                                    <TextBlock Text="Open in Steam"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding UpdateNote}" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource AccentText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateNote}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding Error}" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Danger}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,36,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,48,0">
                        <TextBlock Text="About this mod" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="22"/>
                        <RichTextBox x:Name="Description" Margin="-2,12,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                     IsReadOnly="True" IsDocumentEnabled="True" Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{StaticResource Text}" SelectionBrush="{StaticResource Accent}"
                                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseWheel="OnDescriptionWheel"/>
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Top" Padding="18,4" CornerRadius="6"
                            Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding Facts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Divider" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Divider" Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
