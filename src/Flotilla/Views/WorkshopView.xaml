<UserControl x:Class="Flotilla.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Flotilla.Views"
             xmlns:ui="clr-namespace:Flotilla.UI">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type views:HeroRow}">
            <Grid Margin="28,0,20,4" Height="268" DataContext="{Binding Tile}" SizeChanged="OnHeroSized">
                <Border CornerRadius="10" Background="{StaticResource Surface}"/>
                <Border CornerRadius="10" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Blur}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Border CornerRadius="10" Background="{StaticResource HeroShade}"/>
                <ui:Sonar Width="620" Height="620" Margin="0,-176,-140,-176" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Border CornerRadius="10" BorderBrush="{StaticResource CardLine}" BorderThickness="1"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="32,0,28,0" VerticalAlignment="Center">
                        <TextBlock Text="Most subscribed on the Workshop" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                        <TextBlock Text="{Binding Title}" Margin="0,6,0,0" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed" FontWeight="SemiBold"
                                   FontSize="44" LineHeight="48" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" MaxWidth="520" MaxHeight="44" HorizontalAlignment="Left"
                                   FontSize="15" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                                   Foreground="{StaticResource Soft}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource Primary}" Content="{Binding Action}" IsEnabled="{Binding CanInstall}" Tag="{Binding Progress}"
                                    MinWidth="120" Click="OnHeroInstall"/>
                            <Button Style="{StaticResource GhostButton}" Content="View details" Margin="10,0,0,0" Click="OnHeroOpen"/>
                            <Path Data="{StaticResource IconUsers}" Style="{StaticResource Icon}" Stroke="{StaticResource Muted}" Width="14" Height="14" Margin="20,0,7,0"/>
                            <TextBlock Text="{Binding Subscribers}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Soft}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="284" Height="212" Margin="0,0,28,0">
                        <Border CornerRadius="6" Background="{StaticResource Raised}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Blur}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="6" Background="#4D000000"/>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="Uniform"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="6" BorderBrush="{StaticResource AccentRing}" BorderThickness="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:SectionRow}">
            <Grid Margin="28,26,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="22"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Pill}" Content="Popular" Tag="popular" IsChecked="{Binding Popular, Mode=OneWay}" Click="OnSort"/>
                    <RadioButton Style="{StaticResource Pill}" Content="Recently updated" Tag="updated" IsChecked="{Binding Updated, Mode=OneWay}" Click="OnSort"/>
                    <RadioButton Style="{StaticResource Pill}" Content="Newest" Tag="newest" IsChecked="{Binding Newest, Mode=OneWay}" Click="OnSort"/>
                    <RadioButton Style="{StaticResource Pill}" Content="Name" Tag="name" IsChecked="{Binding ByName, Mode=OneWay}" Click="OnSort"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:TileRow}">
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="19,0,11,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding Columns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Click="OnCard" AutomationProperties.Name="{Binding Title}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:MessageRow}">
            <StackPanel Margin="28,48,20,40" HorizontalAlignment="Center">
                <ui:Sonar Width="200" Height="200" Margin="0,0,0,28" Visibility="{Binding Scanning, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontFamily="{StaticResource Display}" FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="22"/>
                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="440" TextAlignment="Center"
                           TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource Muted}"/>
                <Button Style="{StaticResource Primary}" Content="Try again" Margin="0,20,0,0" HorizontalAlignment="Center" Click="OnRetry"
                        Visibility="{Binding CanRetry, Converter={StaticResource Visible}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="Rows" Focusable="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  SizeChanged="OnResized">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
