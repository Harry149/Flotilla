<UserControl x:Class="Flotilla.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Flotilla.UI">
    <UserControl.Resources>
        <Style x:Key="Point" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,9,0,0"/>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontStretch" Value="{StaticResource DisplayStretch}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ui:ScrollFade.Enabled="True">
        <StackPanel Margin="28,10,28,40" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Source='Credits', Converter={StaticResource Upper}}" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="32"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="230"/>
                </Grid.ColumnDefinitions>

                <Border Padding="30,28" CornerRadius="{StaticResource RoundLarge}" Background="{StaticResource TagBack}"
                        BorderBrush="{StaticResource AccentRing}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource Mark}" BorderBrush="{StaticResource AccentRing}" BorderThickness="1">
                                <Path Data="{StaticResource IconSonar}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="30" Height="30"/>
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source='Made by Harry', Converter={StaticResource Upper}}" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="28"/>
                                <TextBlock x:Name="VersionText" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Margin="0,20,0,0" FontSize="14.5" LineHeight="23" TextWrapping="Wrap" Foreground="{StaticResource Soft}"
                                   Text="Flotilla is built and kept up to date by one person, in their spare time, for every captain who'd rather be at sea than sorting mod folders."/>

                        <TextBlock Margin="0,20,0,0" FontSize="14" FontWeight="SemiBold" Text="What your support pays for"/>
                        <DockPanel Style="{StaticResource Point}">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="13" Height="13"
                                  StrokeThickness="2.2" Margin="0,5,12,0" VerticalAlignment="Top"/>
                            <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Text="Keeping Flotilla working as UBOAT and its mods change, patch after patch."/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Point}">
                            <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="13" Height="13"
                                  StrokeThickness="2.2" Margin="0,5,12,0" VerticalAlignment="Top"/>
                            <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Text="Getting small mod makers' work in front of the players it deserves."/>
                        </DockPanel>

                        <WrapPanel Margin="0,24,0,0">
                            <Button Style="{StaticResource Primary}" Margin="0,0,10,6" Click="OnPayPal" ToolTip="https://paypal.me/QuinnZoie">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHeart}" Style="{StaticResource Icon}" Stroke="{StaticResource OnAccent}" Width="15" Height="15" Margin="0,0,9,0"/>
                                    <TextBlock Text="Donate with PayPal"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,10,6" Click="OnGitHub" ToolTip="https://github.com/Harry149">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCode}" Style="{StaticResource Icon}" Width="15" Height="15" Margin="0,0,9,0"/>
                                    <TextBlock Text="GitHub"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="26,24" CornerRadius="{StaticResource RoundLarge}" Background="{StaticResource Card}"
                        BorderBrush="{StaticResource CardLine}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold" Text="What Flotilla has done for you"/>
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                                   Text="Counted on this PC since Flotilla 1.2."/>
                        <UniformGrid Columns="2" Margin="0,18,0,0" VerticalAlignment="Top">
                            <StackPanel Margin="0,0,12,20">
                                <TextBlock x:Name="StatInstalled" Style="{StaticResource StatNumber}" Text="0"/>
                                <TextBlock Style="{StaticResource StatLabel}" Text="mods installed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="StatUpdated" Style="{StaticResource StatNumber}" Text="0"/>
                                <TextBlock Style="{StaticResource StatLabel}" Text="updates applied"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock x:Name="StatLaunched" Style="{StaticResource StatNumber}" Text="0"/>
                                <TextBlock Style="{StaticResource StatLabel}" Text="games launched"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="StatErrors" Style="{StaticResource StatNumber}" Text="0"/>
                                <TextBlock Style="{StaticResource StatLabel}" Text="mod errors caught"/>
                            </StackPanel>
                        </UniformGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Source='Thanks to', Converter={StaticResource Upper}}" Margin="0,32,0,12" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="20"/>
            <Border Padding="22,18" CornerRadius="{StaticResource RoundLarge}" Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="23" Background="{StaticResource Mark}" BorderBrush="{StaticResource AccentRing}" BorderThickness="1">
                        <Path Data="{StaticResource IconMegaphone}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="22" Height="22"/>
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="OnPingu" ToolTip="https://buymeacoffee.com/pingu565">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCoffee}" Style="{StaticResource Icon}" Width="15" Height="15" Margin="0,0,9,0"/>
                            <TextBlock Text="Buy Pingu a coffee"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Pingu565" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="17"/>
                        <TextBlock Margin="0,3,0,0" FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{StaticResource Soft}"
                                   Text="Helped Flotilla find its players, and got it in front of a lot of captains."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Margin="0,28,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                       Text="Every mod in Flotilla belongs to its author on the Steam Workshop. Flotilla only downloads them from Steam to your PC, and every mod page links back to the original."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
