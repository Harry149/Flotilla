<UserControl x:Class="Flotilla.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Flotilla.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ui:ScrollFade.Enabled="True">
        <StackPanel Margin="28,10,28,40" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Source='Credits', Converter={StaticResource Upper}}" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="32"/>

            <Border Margin="0,24,0,0" Padding="28,26" CornerRadius="{StaticResource RoundLarge}" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource AccentRing}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Mark}" BorderBrush="{StaticResource AccentRing}" BorderThickness="1">
                            <Path Data="{StaticResource IconSonar}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="28" Height="28"/>
                        </Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source='Made by Harry', Converter={StaticResource Upper}}" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="26"/>
                            <TextBlock x:Name="VersionText" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,20,0,0" FontSize="14.5" LineHeight="23" TextWrapping="Wrap" Foreground="{StaticResource Soft}"
                               Text="Flotilla is built and maintained by one person in their spare time. If it saves you time getting your mods sorted, thank you for using it."/>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Style="{StaticResource GhostButton}" Click="OnGitHub" ToolTip="https://github.com/Harry149">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCode}" Style="{StaticResource Icon}" Width="15" Height="15" Margin="0,0,9,0"/>
                                <TextBlock Text="GitHub"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Primary}" Margin="10,0,0,0" Click="OnPayPal" ToolTip="https://paypal.me/QuinnZoie">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHeart}" Style="{StaticResource Icon}" Stroke="{StaticResource OnAccent}" Width="15" Height="15" Margin="0,0,9,0"/>
                                <TextBlock Text="Donate with PayPal"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Source='Why donate?', Converter={StaticResource Upper}}" Margin="0,32,0,12" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="20"/>
            <Border Padding="24,18" CornerRadius="{StaticResource Round}" Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,4,0,12">
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="13" Height="13"
                              StrokeThickness="2.2" Margin="0,5,14,0" VerticalAlignment="Top"/>
                        <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                   Text="Donations keep me maintaining Flotilla, making sure it keeps getting quality updates as UBOAT and its mods change."/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Stroke="{StaticResource Accent}" Width="13" Height="13"
                              StrokeThickness="2.2" Margin="0,5,14,0" VerticalAlignment="Top"/>
                        <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                   Text="They also help me support small mod developers and get their mods the outreach they deserve."/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,24,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                       Text="Every mod in Flotilla belongs to its author on the Steam Workshop. Flotilla only downloads them from Steam to your PC, and every mod page links back to the original."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
