<UserControl x:Class="Flotilla.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Flotilla.UI">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,30,0,12"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontStretch" Value="{StaticResource DisplayStretch}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Round}"/>
            <Setter Property="Padding" Value="20,6"/>
        </Style>
        <Style x:Key="Option" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,12"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" ui:ScrollFade.Enabled="True">
        <StackPanel Margin="28,10,28,40" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Source='Settings', Converter={StaticResource Upper}}" FontFamily="{StaticResource Display}" FontStretch="{StaticResource DisplayStretch}" FontWeight="SemiBold" FontSize="32"/>
            <TextBlock Text="Changes save as soon as you make them." Margin="0,6,0,0" Foreground="{StaticResource Muted}"/>

            <TextBlock Text="{Binding Source='Look', Converter={StaticResource Upper}}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel Margin="0,12">
                    <TextBlock Text="Theme" Style="{StaticResource Label}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Sonar is Flotilla's teal look. Logbook looks like UBOAT's own menus."/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="SonarTheme" Style="{StaticResource Pill}" GroupName="Theme" Content="Sonar" Tag="Sonar" Checked="OnTheme"/>
                        <RadioButton x:Name="LogbookTheme" Style="{StaticResource Pill}" GroupName="Theme" Content="Logbook" Tag="Logbook" Checked="OnTheme"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Source='Playing', Converter={StaticResource Upper}}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Option}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding Settings.ClearCacheBeforePlay}" Click="OnChanged" AutomationProperties.Name="Clear UBOAT's cache before playing"/>
                        <StackPanel>
                            <TextBlock Text="Clear UBOAT's cache before playing" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Play UBOAT first empties the Cache, Temp and Data Sheets folders the game rebuilds on launch, so leftovers from old or removed mods can't cause trouble. The first load takes a little longer."/>
                            <Button x:Name="ClearNow" Style="{StaticResource GhostButton}" Height="32" Padding="14,0" FontSize="13" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Click="OnClearCache" Content="Clear now"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Source='Mods', Converter={StaticResource Upper}}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Option}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding Settings.InstallRequirements}" Click="OnChanged" AutomationProperties.Name="Install the mods a mod needs"/>
                        <StackPanel>
                            <TextBlock Text="Install the mods a mod needs" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="When a mod lists required items on the Workshop, installing it installs those too and loads them before it. Installed shows a warning with a Fix button when one is missing, switched off or in the wrong place."/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Rule}"/>
                    <DockPanel Style="{StaticResource Option}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding Settings.WarnGameVersion}" Click="OnChanged" AutomationProperties.Name="Warn about mods made for another version of UBOAT"/>
                        <StackPanel>
                            <TextBlock Text="Warn about mods made for another version of UBOAT" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="Flags mods whose manifest names a different release or patch, like UBOAT's launcher does. Your UBOAT:"/>
                                <Run Text="{Binding GameVersion, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/><Run Text=", read from the game's log."/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Rule}"/>
                    <DockPanel Style="{StaticResource Option}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding Settings.CheckGameLog}" Click="OnChanged" AutomationProperties.Name="Check the game log after you play"/>
                        <StackPanel>
                            <TextBlock Text="Check the game log after you play" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="When UBOAT closes, Flotilla reads its log for mods that failed to compile, crashed, failed to load or logged their own errors, tells you which one, and offers to save an error log you can send to the mod's author. Off unless you turn it on. Keep Flotilla open while you play so it can check straight away."/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Source='Flotilla', Converter={StaticResource Upper}}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Option}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding Settings.CheckForUpdates}" Click="OnChanged" AutomationProperties.Name="Check for Flotilla updates when it starts"/>
                        <StackPanel>
                            <TextBlock Text="Check for Flotilla updates when it starts" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0" FontSize="13" Content="Check now" Click="OnCheckUpdates"/>
                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0" FontSize="13" Margin="10,0,0,0" Content="Show the tour" Click="OnTour"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Rule}"/>
                    <DockPanel Style="{StaticResource Option}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding Settings.CountMe}" Click="OnCountMe" AutomationProperties.Name="Count me as a sailor"/>
                        <StackPanel>
                            <TextBlock Text="Count me as a sailor" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="While Flotilla is open, it sends Flotilla's server a random ID made on this PC and the Flotilla version every few minutes, so the top bar can show how many people have it open. Nothing else is sent: no name, Steam account or mod list."/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Rule}"/>
                    <DockPanel Style="{StaticResource Option}">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                      IsChecked="{Binding Settings.SendErrorReports}" Click="OnChanged" AutomationProperties.Name="Send Flotilla's error reports"/>
                        <StackPanel>
                            <TextBlock Text="Send Flotilla's error reports" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="If Flotilla itself hits an error, it sends me the error log so I can fix it: the Flotilla and Windows version and the technical details of the error. Your Windows username is removed first. Nothing about your mods or game log is sent."/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Source='Folders', Converter={StaticResource Upper}}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel Style="{StaticResource Option}">
                        <StackPanel>
                            <TextBlock Text="UBOAT's data folder" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="FolderText" Style="{StaticResource Hint}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="14,0" FontSize="13" Content="Change" Click="OnChangeFolder"
                                        ToolTip="Only needed if UBOAT keeps its saves and mods somewhere unusual"/>
                                <Button x:Name="ResetFolder" Style="{StaticResource GhostButton}" Height="32" Padding="14,0" FontSize="13" Margin="10,0,0,0"
                                        Content="Use the usual folder" Click="OnResetFolder"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Rule}"/>
                    <WrapPanel Margin="0,14,0,12">
                        <Button Style="{StaticResource Quiet}" Margin="0,0,24,4" Click="OnOpenData">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}" Width="14" Height="12" Margin="0,0,8,0"/>
                                <TextBlock Text="UBOAT's data folder"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Quiet}" Margin="0,0,24,4" Click="OnOpenMods">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}" Width="14" Height="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Mods folder"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Quiet}" Margin="0,0,24,4" Click="OnOpenLog">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLog}" Style="{StaticResource Icon}" Width="13" Height="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Game log"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Quiet}" Margin="0,0,24,4" Click="OnOpenFlotilla" ToolTip="Profiles, settings, the Workshop cache and SteamCMD">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}" Width="14" Height="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Flotilla's own folder"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
