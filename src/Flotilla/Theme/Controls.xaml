<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Flotilla.UI"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <BooleanToVisibilityConverter x:Key="Visible"/>
    <ui:Upper x:Key="Upper"/>


    <ui:VisibleWhenSet x:Key="VisibleWhenSet"/>

    <Style x:Key="Focus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="{StaticResource Accent}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="{StaticResource Accent}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
        <Style.Resources>
            <DataTemplate DataType="{x:Type sys:String}">
                <TextBlock Text="{Binding Converter={StaticResource Upper}}"/>
            </DataTemplate>
        </Style.Resources>
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource ButtonFont}"/>
        <Setter Property="FontStretch" Value="{StaticResource ButtonStretch}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Round}" SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            <Rectangle Height="3" Margin="6,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource Accent}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=0, TargetNullValue=0}"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Raised}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Style.Resources>
            <DataTemplate DataType="{x:Type sys:String}">
                <TextBlock Text="{Binding Converter={StaticResource Upper}}"/>
            </DataTemplate>
        </Style.Resources>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Ghost}"/>
        <Setter Property="FontFamily" Value="{StaticResource ButtonFont}"/>
        <Setter Property="FontStretch" Value="{StaticResource ButtonStretch}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Round}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource GhostHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Ghost}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Quiet" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Round}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Ghost}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Round}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Ghost}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Round}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource CloseHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SideMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource NavFont}"/>
        <Setter Property="FontStretch" Value="{StaticResource NavStretch}"/>
        <Setter Property="FontSize" Value="{StaticResource NavSize}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0,10,0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource Round}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Mark" Width="3" Height="18" Margin="-14,0,0,0" HorizontalAlignment="Left"
                                CornerRadius="0,2,2,0" Background="{StaticResource Accent}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource NavHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource SideText}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource NavOn}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource NavOnText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource RoundPill}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Chip}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BetaChip" TargetType="ContentControl">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ToolTip" Value="Still being tested. Tell me if it gets something wrong."/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Padding="6,1,6,2" CornerRadius="8" Background="{StaticResource TagBack}" BorderBrush="{StaticResource AccentRing}" BorderThickness="1">
                        <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentText}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face" Background="Transparent" BorderBrush="{StaticResource Ghost}" BorderThickness="1" CornerRadius="{StaticResource RoundPill}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Tick" Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Stroke="{StaticResource AccentText}"
                                  Width="10" Height="10" StrokeThickness="2.2" Margin="0,1,7,0" Visibility="Collapsed"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource TagBack}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentRing}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TagButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TagText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Padding="9,2,9,3" CornerRadius="{StaticResource RoundLarge}" Background="{StaticResource TagBack}" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentRing}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        <Setter Property="Background" Value="{StaticResource DangerBack}"/>
    </Style>

    <Style x:Key="SideQuiet" TargetType="Button" BasedOn="{StaticResource Quiet}">
        <Setter Property="Foreground" Value="{StaticResource SideMuted}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SideText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ProfileButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SideSoft}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="{StaticResource Round}" Padding="10,0,4,0">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource NavHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource SideText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{StaticResource Surface}" BorderBrush="{StaticResource Ghost}" BorderThickness="1" CornerRadius="{StaticResource Round}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Search" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Round}">
                        <Grid Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Stroke="{StaticResource Muted}" Width="15" Height="15"/>
                            <TextBlock x:Name="Hint" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource Muted}" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"/>
                            <Border x:Name="Keys" Grid.Column="2" VerticalAlignment="Center" BorderBrush="{StaticResource Ghost}" BorderThickness="1"
                                    CornerRadius="{StaticResource RoundSmall}" Padding="6,1,6,2">
                                <TextBlock Text="Ctrl F" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Ghost}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                            <Setter TargetName="Keys" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="11" Background="{StaticResource Track}"/>
                        <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Muted}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="Slide"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Soft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource OnAccent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Row" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Back" Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                            CornerRadius="{StaticResource Round}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource CardHover}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource AccentRing}"/>
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip" Value="Add to favourites"/>
        <Setter Property="AutomationProperties.Name" Value="Favourite"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face" CornerRadius="{StaticResource RoundPill}" Background="{StaticResource Badge}">
                        <Path x:Name="Star" Data="{StaticResource IconStar}" Style="{StaticResource Icon}" Stroke="{StaticResource Soft}" Fill="Transparent"
                              Width="15" Height="15" StrokeThickness="1.6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Star" Property="Stroke" Value="{StaticResource Warn}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Star" Property="Stroke" Value="{StaticResource Warn}"/>
                            <Setter TargetName="Star" Property="Fill" Value="{StaticResource Warn}"/>
                            <Setter Property="ToolTip" Value="Remove from favourites"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Margin" Value="9,0,9,18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Frame" Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                CornerRadius="{StaticResource Round}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border CornerRadius="{StaticResource RoundTop}" Background="{StaticResource Surface}"/>
                                <Border CornerRadius="{StaticResource RoundTop}" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Blur}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="{StaticResource RoundTop}" Background="#59000000"/>
                                <Border CornerRadius="{StaticResource RoundTop}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Border.Background>
                                </Border>

                                <Border x:Name="Badge" Margin="10" Padding="7,3,9,4" CornerRadius="{StaticResource RoundLarge}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{StaticResource Badge}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="BadgeIcon" Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Stroke="{StaticResource AccentText}"
                                              Width="10" Height="10" StrokeThickness="2.2" Margin="0,1,5,0"/>
                                        <TextBlock x:Name="BadgeText" Text="{Binding Badge}" Foreground="{StaticResource AccentText}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <ToggleButton x:Name="Star" Style="{StaticResource StarToggle}" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              IsChecked="{Binding IsFavourite}" Visibility="Hidden"/>

                                <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                    <TextBlock Text="{Binding CardTitle}" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconUsers}" Style="{StaticResource Icon}" Stroke="{StaticResource Muted}" Width="13" Height="13"/>
                                            <TextBlock Text="{Binding Subscribers}" Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                                            <StackPanel x:Name="Votes" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed"
                                                        ToolTip="{Binding VoteSummary}">
                                                <Path x:Name="VoteIcon" Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Stroke="{StaticResource AccentText}"
                                                      Width="11" Height="11" StrokeThickness="2.2"/>
                                                <TextBlock x:Name="VoteText" Text="{Binding VoteBadge}" Margin="4,0,0,0" FontSize="12.5" Foreground="{StaticResource AccentText}"/>
                                            </StackPanel>
                                            <Border x:Name="MadeFor" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="{StaticResource RoundLarge}" Padding="7,1,7,2"
                                                    Background="{StaticResource TagBack}" ToolTip="{Binding MadeForTip}">
                                                <TextBlock x:Name="MadeForText" Text="{Binding MadeFor}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                                            </Border>
                                        </StackPanel>
                                        <Border x:Name="TagChip" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right" MaxWidth="120" Background="{StaticResource TagBack}" CornerRadius="{StaticResource RoundLarge}" Padding="8,2,8,3">
                                            <TextBlock Text="{Binding Tag}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TagText}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentLine}"/>
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource CardHover}"/>
                            <Setter TargetName="Frame" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Frame" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Star" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                            <Setter TargetName="Star" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasVotes}" Value="True">
                            <Setter TargetName="Votes" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VotesMostlyBroken}" Value="True">
                            <Setter TargetName="VoteIcon" Property="Data" Value="{StaticResource IconWarning}"/>
                            <Setter TargetName="VoteIcon" Property="Stroke" Value="{StaticResource Warn}"/>
                            <Setter TargetName="VoteText" Property="Foreground" Value="{StaticResource Warn}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="{x:Null}">
                            <Setter TargetName="TagChip" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MadeFor}" Value="{x:Null}">
                            <Setter TargetName="MadeFor" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MadeForOther}" Value="True">
                            <Setter TargetName="MadeFor" Property="Background" Value="{StaticResource WarnBack}"/>
                            <Setter TargetName="MadeForText" Property="Foreground" Value="{StaticResource Warn}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource IconDownload}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Outdated">
                            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource IconUpdate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Danger}"/>
                            <Setter TargetName="BadgeIcon" Property="Stroke" Value="{StaticResource Danger}"/>
                            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource IconWarning}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{StaticResource Ghost}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource GhostHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,6">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageUpCommand"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageDownCommand"/>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="6,1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageLeftCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PageButton}" Command="ScrollBar.PageRightCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Ghost}" BorderThickness="1" CornerRadius="{StaticResource Round}" Padding="4">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Back" Background="Transparent" CornerRadius="{StaticResource RoundSmall}" Padding="12,7,28,8">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Ghost}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{StaticResource Line}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Ghost}" BorderThickness="1" CornerRadius="{StaticResource Round}" Padding="10,6" MaxWidth="320">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
