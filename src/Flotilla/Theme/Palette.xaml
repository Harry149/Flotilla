<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="DeepColor">#050D10</Color>
    <Color x:Key="AccentColor">#5BE0C3</Color>

    <RadialGradientBrush x:Key="Bg" Center="0.7,-0.1" GradientOrigin="0.7,-0.1" RadiusX="0.94" RadiusY="0.85">
        <GradientStop Color="#0F2B33" Offset="0"/>
        <GradientStop Color="#08161B" Offset="0.45"/>
        <GradientStop Color="{StaticResource DeepColor}" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="Side" Color="#99030A0C"/>
    <SolidColorBrush x:Key="Surface" Color="#0D8CE6D7"/>
    <SolidColorBrush x:Key="Card" Color="#098CE6D7"/>
    <SolidColorBrush x:Key="CardHover" Color="#128CE6D7"/>
    <SolidColorBrush x:Key="CardLine" Color="#1F8CE6D7"/>
    <SolidColorBrush x:Key="Line" Color="#1A8CE6D7"/>
    <SolidColorBrush x:Key="Raised" Color="#0F2328"/>
    <SolidColorBrush x:Key="NavOn" Color="#145BE0C3"/>
    <SolidColorBrush x:Key="NavHover" Color="#0A8CE6D7"/>
    <SolidColorBrush x:Key="Chip" Color="#178CE6D7"/>
    <SolidColorBrush x:Key="Track" Color="#1F8CE6D7"/>
    <SolidColorBrush x:Key="Ghost" Color="#1F8CE6D7"/>
    <SolidColorBrush x:Key="GhostHover" Color="#338CE6D7"/>

    <SolidColorBrush x:Key="Text" Color="#DCEBE8"/>
    <SolidColorBrush x:Key="Soft" Color="#B3CCC8"/>
    <SolidColorBrush x:Key="Muted" Color="#8AAAA6"/>
    <SolidColorBrush x:Key="Faint" Color="#62807C"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="#7DEAD2"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#46C7AB"/>
    <SolidColorBrush x:Key="AccentText" Color="#6FE8CD"/>
    <SolidColorBrush x:Key="AccentLine" Color="#B35BE0C3"/>
    <SolidColorBrush x:Key="AccentRing" Color="#595BE0C3"/>
    <SolidColorBrush x:Key="OnAccent" Color="#04201A"/>
    <SolidColorBrush x:Key="Badge" Color="#D904201A"/>
    <SolidColorBrush x:Key="TagBack" Color="#145BE0C3"/>
    <SolidColorBrush x:Key="TagText" Color="#8FD8C8"/>
    <SolidColorBrush x:Key="Mark" Color="#0C2A2C"/>

    <SolidColorBrush x:Key="Danger" Color="#FF8C7F"/>
    <SolidColorBrush x:Key="DangerBack" Color="#29FF7869"/>
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C"/>

    <LinearGradientBrush x:Key="HeroShade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F2040E11" Offset="0"/>
        <GradientStop Color="#BF040E11" Offset="0.5"/>
        <GradientStop Color="#80040E11" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PageShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80040E11" Offset="0"/>
        <GradientStop Color="#D9040E11" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FadeOut" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="Black" Offset="0.4"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

</ResourceDictionary>
