<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="DeepColor">#120F0A</Color>
    <Color x:Key="AccentColor">#6F8F88</Color>

    <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#2E271D" Offset="0"/>
        <GradientStop Color="#1C1812" Offset="0.5"/>
        <GradientStop Color="{StaticResource DeepColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Side" Color="#F2050403"/>
    <SolidColorBrush x:Key="Surface" Color="#F3EBD6"/>
    <SolidColorBrush x:Key="Card" Color="#DDD0AE"/>
    <SolidColorBrush x:Key="CardHover" Color="#E5D9BA"/>
    <SolidColorBrush x:Key="CardLine" Color="#9C8D6A"/>
    <SolidColorBrush x:Key="Line" Color="#B3A47F"/>
    <SolidColorBrush x:Key="Raised" Color="#EFE6CE"/>
    <SolidColorBrush x:Key="NavOn" Color="#E9DFC4"/>
    <SolidColorBrush x:Key="NavHover" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Chip" Color="#CFC1A0"/>
    <SolidColorBrush x:Key="Track" Color="#B6A882"/>
    <SolidColorBrush x:Key="Ghost" Color="#CBBD95"/>
    <SolidColorBrush x:Key="GhostHover" Color="#D9CCA7"/>

    <SolidColorBrush x:Key="Text" Color="#3B2E1E"/>
    <SolidColorBrush x:Key="Soft" Color="#4F4030"/>
    <SolidColorBrush x:Key="Muted" Color="#6D5D45"/>
    <SolidColorBrush x:Key="Faint" Color="#8C7C60"/>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="#80A09A"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#5E7D76"/>
    <SolidColorBrush x:Key="AccentText" Color="#3A5C55"/>
    <SolidColorBrush x:Key="AccentLine" Color="#5B4A33"/>
    <SolidColorBrush x:Key="AccentRing" Color="#6E5C40"/>
    <SolidColorBrush x:Key="OnAccent" Color="#16201E"/>
    <SolidColorBrush x:Key="Badge" Color="#EBEFE6D2"/>
    <SolidColorBrush x:Key="TagBack" Color="#CFC1A0"/>
    <SolidColorBrush x:Key="TagText" Color="#4A3D2C"/>
    <SolidColorBrush x:Key="Mark" Color="#2A241B"/>

    <SolidColorBrush x:Key="Warn" Color="#9A5B12"/>
    <SolidColorBrush x:Key="WarnBack" Color="#E8C98A"/>
    <SolidColorBrush x:Key="Danger" Color="#A3392B"/>
    <SolidColorBrush x:Key="DangerBack" Color="#E7C2B4"/>
    <SolidColorBrush x:Key="CloseHover" Color="#B04A3A"/>

    <LinearGradientBrush x:Key="HeroShade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F5E9DFC4" Offset="0"/>
        <GradientStop Color="#CCE9DFC4" Offset="0.5"/>
        <GradientStop Color="#59E9DFC4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PageShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6E9DFC4" Offset="0"/>
        <GradientStop Color="#F5E9DFC4" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FadeOut" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="Black" Offset="0.4"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SideText" Color="#F3EFE6"/>
    <SolidColorBrush x:Key="SideSoft" Color="#D8D0BE"/>
    <SolidColorBrush x:Key="SideMuted" Color="#A89F8A"/>
    <SolidColorBrush x:Key="SideFaint" Color="#8D8370"/>
    <SolidColorBrush x:Key="SideSurface" Color="#1C1813"/>
    <SolidColorBrush x:Key="SideLine" Color="#3A3128"/>
    <SolidColorBrush x:Key="NavOnText" Color="#3B2E1E"/>
    <SolidColorBrush x:Key="Paper" Color="#E9DFC4"/>
    <SolidColorBrush x:Key="PaperLine" Color="#3A2F23"/>
    <Thickness x:Key="PaperEdge">7,2,2,2</Thickness>
    <Thickness x:Key="PaperMargin">8,8,8,8</Thickness>
    <Thickness x:Key="PaperInset">15,0,10,10</Thickness>
    <Thickness x:Key="PaperInsetFull">15,10,10,10</Thickness>

    <CornerRadius x:Key="Round">1</CornerRadius>
    <CornerRadius x:Key="RoundLarge">2</CornerRadius>
    <CornerRadius x:Key="RoundSmall">0</CornerRadius>
    <CornerRadius x:Key="RoundTop">0</CornerRadius>
    <CornerRadius x:Key="RoundPill">2</CornerRadius>

    <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ButtonFont">Bahnschrift, Segoe UI</FontFamily>
    <FontStretch x:Key="DisplayStretch">Condensed</FontStretch>
    <FontFamily x:Key="NavFont">Bahnschrift, Segoe UI</FontFamily>
    <FontStretch x:Key="NavStretch">Condensed</FontStretch>
    <sys:Double x:Key="NavSize">17</sys:Double>
    <FontStretch x:Key="ButtonStretch">Condensed</FontStretch>

</ResourceDictionary>
